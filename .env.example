# SEC requires a User-Agent identifying the requester plus a contact email.
# Requests without an email are rejected with HTTP 403.
SRA_SEC_USER_AGENT="StockResearchAssistant/0.1 you@example.com"

# Owner role: full DDL/DML. Used by migrations and ingest.
SRA_DSN="postgresql://localhost:5432/sra"

# Read-only role: used by the run_sql agent tool. SELECT-only grants.
SRA_READONLY_DSN="postgresql://sra_reader:CHANGEME@localhost:5432/sra"

SRA_OLLAMA_URL="http://localhost:11434"
SRA_GENERATION_MODEL="gemma4:latest"
SRA_EMBEDDING_MODEL="nomic-embed-text"

# Retrieved passages are large; the ollama default of 4096 truncates answers.
SRA_CONTEXT_TOKENS=16384

# Upstox (NSE/BSE live quotes). Optional: only needed for live-quote
# questions and `sra upstox ingest-instruments`; everything else works
# without these.
#
# Recommended: a read-only Analytics Token (1-year validity, scoped to
# Market Data), from your Upstox developer dashboard. If set, this is used
# and nothing else below is needed.
SRA_UPSTOX_ANALYTICS_TOKEN=""

# Alternative: full OAuth2 app credentials, used by `sra upstox login` for a
# daily access token (only consulted when SRA_UPSTOX_ANALYTICS_TOKEN is
# unset). Create an app at https://developer.upstox.com to get these two.
SRA_UPSTOX_API_KEY=""
SRA_UPSTOX_API_SECRET=""
# Must exactly match the Redirect URI registered for the app.
SRA_UPSTOX_REDIRECT_URI="https://127.0.0.1/callback"
