# SEC requires a User-Agent identifying the requester plus a contact email.
# Requests without an email are rejected with HTTP 403.
SRA_SEC_USER_AGENT="StockResearchAssistant/0.1 you@example.com"

# Owner role: full DDL/DML. Used by migrations and ingest.
SRA_DSN="postgresql://localhost:5432/sra"

# Read-only role: used by the run_sql agent tool. SELECT-only grants.
SRA_READONLY_DSN="postgresql://sra_reader:CHANGEME@localhost:5432/sra"

SRA_OLLAMA_URL="http://localhost:11434"
SRA_GENERATION_MODEL="gemma4:latest"
SRA_EMBEDDING_MODEL="nomic-embed-text"

# Retrieved passages are large; the ollama default of 4096 truncates answers.
SRA_CONTEXT_TOKENS=32768
